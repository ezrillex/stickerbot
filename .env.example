# Cloudflare Account & AI Gateway
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_GATEWAY_ID=default
CLOUDFLARE_GATEWAY_TOKEN=your_cloudflare_gateway_token
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Google AI Studio (Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Bot Settings
DAILY_LIMIT=50
STICKER_PACK=Rolex AI
STICKER_AUTHOR=StickerBot
BOT_PREFIX=!sticker
BOT_PHONE_NUMBER= # Optional: e.g. 15551234567 (with country code, no + or spaces)
